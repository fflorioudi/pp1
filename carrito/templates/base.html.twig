<!DOCTYPE html>

<html>
    <head>
        <meta charset="UTF-8">

        <title>{% block title %}Carrito de Compras{% endblock %}</title>

        <link
            rel="stylesheet"
            href="{{ asset('css/estilos.css') }}"
        >
    </head>

    <body>

        <header class="header">
    <div>Carrito de Compras</div>

    {% if app.user %}
        <div>
            <button class="btn-ligth">Ver Orden</button>

            <a href="{{ path('app_logout') }}" class="btn-ligth" style="text-decoration: none;">
                Salir
            </a>
        </div>
    {% endif %}
</header>

        <main>
            {% block body %}{% endblock %}
        </main>

    </body>
</html>