{% extends 'base.html.twig' %}

{% block title %}
    Lista de productos
{% endblock %}

{% block body %}
    <style>
        .productos-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            padding: 20px;
            font-family: Arial, sans-serif;
        }
        .producto-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            text-align: center;
            background: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .producto-img {
            max-width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 10px;
        }
        .producto-precio {
            font-size: 1.25rem;
            color: #2ecc71;
            font-weight: bold;
            margin: 10px 0;
        }
    </style>

    <h1 class="title" style="text-align: center; margin-top: 20px;">Lista de productos</h1>
    <p style="text-align: center; color: #666;">Esta es la lista de productos disponibles</p>

    <!-- a. Estructura for de twig para iterar los productos -->
    <div class="productos-container">
        {% for producto in productos %}
            <div class="producto-card">
                <!-- b. Formato y estilos para renderizar cada campo -->
                <img class="producto-img" src="{{ asset(producto.imagen) }}" alt="{{ producto.nombre }}">
                <h3>{{ producto.nombre }}</h3>
                <p>{{ producto.descripcion }}</p>
                <div class="producto-precio">${{ producto.precio }}</div>
            </div>
        {% else %}
            <p style="grid-column: 1/-1; text-align: center;">No hay productos cargados todavía.</p>
        {% endfor %}
    </div>
{% endblock %}